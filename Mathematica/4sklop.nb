Cell[TextData[{
 "Odgovor : Ni\[CHacek]le so x=-2, x=",
 Cell[BoxData[
  RowBox[{"-", 
   FractionBox["1", "2"]}]],
  CellChangeTimes->{3.812598443784713*^9, 3.8126001040136757`*^9},
  ExpressionUUID->"f17cf0b2-bddc-4bc5-8f50-c50a5e2fef0b"],
