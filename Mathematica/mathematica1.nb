Cell[TextData[{
 "Na kocko s stranico ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],ExpressionUUID->
  "b5f3e715-e0d6-4f56-88ba-fdead7faa6c7"],
 " postavimo drugo kocko s telesno diagonalo, enako stranici prve kocke, na \
drugo kocko spet tretjo s telesno diagonalo, enako stranici druge kocke, in \
to ponavljamo brez konca. Izra\[CHacek]unajte vi\[SHacek]ino tako dobljenega \
telesa: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["i", "TI"], "\[LongEqual]", "0"}], "\[Infinity]", 
