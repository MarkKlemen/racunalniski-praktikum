Cell[TextData[{
 "1. Priredite polinom  ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SuperscriptBox["x", "2"], " ", 
       RowBox[{"(", 
        RowBox[{"y", "-", "1"}], ")"}]}], "-", 
      RowBox[{
       SuperscriptBox["x", "3"], 
       SuperscriptBox["y", "5"]}], "+", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"x", "-", "1"}], ")"}], "7"], "x", " ", "y", " ", 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["x", "2"], "+", 
         RowBox[{"2", "x", " ", "y"}], "+", 
         SuperscriptBox["y", "3"]}], ")"}]}]}], ")"}], "2"], 
   TraditionalForm]],ExpressionUUID->"0de55297-f911-495c-a7c1-ad07f83b627c"],
 "  spremenljivki ",
 StyleBox["q", "Code"],
 ".\n2. Raz\[SHacek]irite ga tako, da dobite vsoto monomov. Poi\[SHacek]\
\[CHacek]ite ustrezno funkcijo v dokumentaciji.\n3. Razvijte polinom po \
potencah ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "adc22a02-b63c-4229-ac99-1b2abd160066"],
 "  (koeficienti bodo polinomi v ",
