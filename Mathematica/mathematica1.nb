         FractionBox[
          StyleBox["a", "TI"], 
          SuperscriptBox[
           SqrtBox["3"], 
           StyleBox["i", "TI"]]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\sum_{i=0}^\\infty \\frac{a}{\\sqrt{3}^i}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a15efc02-9cbb-4330-b1ff-8d02d41d8adb"],
 "."
}], "Text",
