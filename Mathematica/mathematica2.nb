Cell[TextData[{
 
 CounterBox["Subsection"],
 ". naloga:"
}], "Subsection",
 CellChangeTimes->{{3.784103669941997*^9, 3.7841036803482323`*^9}, {
   3.909124752756357*^9, 3.9091247528668833`*^9}, 3.909124787128665*^9, {
