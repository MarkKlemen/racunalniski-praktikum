  SubsuperscriptBox["\[Sum]", 
   RowBox[{"i", "=", "1"}], "k"], 
  RowBox[{"(", 
   RowBox[{"16", "-", 
    RowBox[{"2", "i"}]}], ")"}]}]], "Input",
 CellChangeTimes->{{3.9764523835664864`*^9, 3.9764524236001816`*^9}},
 CellLabel->"In[26]:=",ExpressionUUID->"621fb94d-a8dd-6f48-9071-78bc342cea79"],

